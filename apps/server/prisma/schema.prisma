generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  name                String?
  password            String?
  gender              String?
  age                 Int?
  goals               String?
  dietary_preferences String?
  medical_conditions  String?
  createdAt           DateTime @default(now())
}
