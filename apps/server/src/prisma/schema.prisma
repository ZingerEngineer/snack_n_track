generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MealAuthor {
  SNACK_MODEL
  GEMINI
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

enum FoodType {
  // Common food categories
  VEGETABLE
  FRUIT
  GRAIN
  DESSERT
  BEVERAGE
  DAIRY
  FATS
  NUTS
  MEAT
  MEAL
}

enum PortionUnit {
  // Volume (liquid) measurements
  TEASPOON
  TABLESPOON
  CUP
  MILLILITER
  LITER
  PINT
  QUART
  GALLON

  // Weight measurements
  GRAM
  KILOGRAM
  OUNCE
  POUND

  // Other generic or small quantity measures
  PINCH
  DASH
  PIECE
  SLICE
  SERVING
}

enum NutritionUnit {
  // Mass units:
  g
  kg
  mg
  mcg

  // Volume units:
  L
  mL
  mcL

  // Energy units:
  kcal
  kJ

  // Additional units:
  oz
  lb
}

enum RatingType {
  APP_OVERALL
  MEAL_RECOMMENDATION
  FOOD_RECOGNITION
  NUTRITION_ACCURACY
  USER_EXPERIENCE
  FEATURE_SPECIFIC
}

enum RatingScale {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  avatar        String?
  password      String
  role          String    @default("USER")
  age           Int?
  gender        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt
  deletedAt     DateTime?
  softDelete    Boolean   @default(false)
  introComplete Boolean   @default(false)

  medicalConditions     UserMedicalCondition[]
  progress              Progress[]
  RefreshToken          RefreshToken[]
  preferences           Preferences?
  healthTracking        UserHealthTracking[]
  meals                 Meal[]
  ratings               UserRating[]
  feedback              AppFeedback[]
  featureUsageAnalytics FeatureUsageAnalytics[]
}

model Preferences {
  id            String  @id @default(uuid())
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String  @unique
  language      String  @default("en")
  theme         String  @default("light")
  notifications Boolean @default(false)
}

model UserHealthTracking {
  id                String    @id @default(uuid())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  weight            Float?
  height            Float?
  BMI               Float?
  sugarLevel        Float?
  bloodPressure     String?
  cholesterolLevel  Float?
  dietaryPreference String?
  activityLevel     String?
  dateRecorded      DateTime?
}

model Progress {
  id             String    @id @default(uuid())
  goalId         String?
  userId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt
  deletedAt      DateTime?
  softDelete     Boolean   @default(false)
  progressStatus String    @default("ACTIVE")
  progressType   String    @default("WEIGHT")
  progressGoal   String    @default("WEIGHT")
  progressUnit   String    @default("kg")
  progressValue  Float     @default(0)
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Meal {
  id                  String         @id @default(uuid())
  name                String         @default("New Meal")
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId              String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime?      @updatedAt
  deletedAt           DateTime?
  totalCalories       Float
  author              MealAuthor     @default(GEMINI)
  certaintyPercentage Float          @default(0) // Percentage of certainty for meal recognition
  mealType            MealType       @default(OTHER)
  foodItems           MealFoodItem[]
}

model MealFoodItem {
  mealId   String
  foodId   Int
  meal     Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([mealId, foodId])
}

model FoodItem {
  id               Int              @id @default(autoincrement())
  foodName         String           @unique
  foodType         FoodType         @default(MEAL)
  portionUnit      PortionUnit      @default(SERVING)
  portionSizeValue Float            @default(1)
  ingredientString String
  ingredients      FoodIngredient[]
  MealFoodItem     MealFoodItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime?        @updatedAt
  deletedAt        DateTime?
}

model FoodIngredient {
  foodId       Int
  ingredientId String
  foodItem     FoodItem   @relation(fields: [foodId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([foodId, ingredientId])
}

model Ingredient {
  id String @id @default(uuid())

  ingredientName String @unique

  calories     Float         @default(0)
  caloriesUnit NutritionUnit @default(kcal)

  carbohydratesAmount Float         @default(0)
  carbohydratesUnit   NutritionUnit @default(g)

  proteinsAmount Float         @default(0)
  proteinsUnit   NutritionUnit @default(g)

  fatsAmount Float         @default(0)
  fatsUnit   NutritionUnit @default(g)

  sugarAmount Float         @default(0)
  sugarUnit   NutritionUnit @default(g)

  ironAmount Float         @default(0)
  ironUnit   NutritionUnit @default(mg)

  sodiumAmount Float         @default(0)
  sodiumUnit   NutritionUnit @default(mg)

  potassiumAmount Float         @default(0)
  potassiumUnit   NutritionUnit @default(mg)

  vitaminC     Float         @default(0)
  vitaminCUnit NutritionUnit @default(mg)

  vitaminB6     Float         @default(0)
  vitaminB6Unit NutritionUnit @default(mg)

  vitaminB12     Float         @default(0)
  vitaminB12Unit NutritionUnit @default(mcg)

  FoodIngredient FoodIngredient[]
}

model MedicalCondition {
  id            String                 @id @default(uuid())
  conditionName String
  decscription  String?
  symptoms      String?
  treatment     String?
  medications   String?
  users         UserMedicalCondition[]
}

model UserMedicalCondition {
  userId             String
  medicalConditionId String
  user               User             @relation(fields: [userId], references: [id])
  medicalCondition   MedicalCondition @relation(fields: [medicalConditionId], references: [id])

  @@id([userId, medicalConditionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  expiresAt DateTime  @default(dbgenerated("now() + interval '7 days'"))

  user User @relation(fields: [userId], references: [id])
}

model UserRating {
  id         String      @id @default(uuid())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  ratingType RatingType
  rating     RatingScale
  comment    String?     @db.Text
  context    Json? // Store additional context (feature used, meal rated, etc.)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime?   @updatedAt

  // Ensure one rating per user per type (can be updated)
  @@unique([userId, ratingType])
}

model AppFeedback {
  id               String    @id @default(uuid())
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId           String?
  feedbackType     String // "bug", "feature_request", "improvement", "compliment"
  title            String
  description      String    @db.Text
  priority         String    @default("medium") // "low", "medium", "high", "critical"
  status           String    @default("open") // "open", "in_progress", "resolved", "closed"
  category         String? // "ui", "performance", "accuracy", "functionality"
  reproducible     Boolean   @default(false)
  deviceInfo       Json? // Store device/browser info
  appVersion       String?
  attachments      String[] // URLs to screenshots or logs
  adminResponse    String?   @db.Text
  adminRespondedAt DateTime?
  adminRespondedBy String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime? @updatedAt
}

model FeatureUsageAnalytics {
  id          String   @id @default(uuid())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  featureName String // "meal_scan", "manual_entry", "nutrition_view", etc.
  action      String // "view", "create", "update", "delete", "share"
  sessionId   String? // Group actions by session
  duration    Int? // Time spent in milliseconds
  success     Boolean  @default(true)
  errorCode   String?
  metadata    Json? // Additional context data
  timestamp   DateTime @default(now())

  @@index([userId, featureName])
  @@index([timestamp])
}
