{
  "version": "1.0.0",
  "name": "snack_n_track",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run mobile\"",
    "server": "npm run -w apps/server dev",
    "mobile": "npm run -w apps/mobile dev",
    "server_mobile": "concurrently \"npm run server\" \"npm run -w apps/mobile dev\"",
    "compose-up": "docker compose  -d",
    "compose-db-up": "docker compose up -d db",
    "compose-db-down": "docker compose down",
    "clean": "rm -rf **/node_modules **/dist node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  },
  "dependencies": {}
}

